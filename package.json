{
  "name": "codex-memory-sidecar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local MCP memory sidecar for Codex app.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "dashboard": "tsc -p tsconfig.json && node dist/src/dashboard.js",
    "smoke:mcp": "tsc -p tsconfig.json && node dist/src/mcp-smoke.js",
    "smoke:ollama": "tsc -p tsconfig.json && node dist/src/ollama-smoke.js",
    "smoke:practical": "tsc -p tsconfig.json && node dist/src/practical-smoke.js",
    "smoke:comparison": "tsc -p tsconfig.json && node dist/src/comparison-smoke.js",
    "start": "node dist/src/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.13.0",
    "better-sqlite3": "^11.10.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
