{
  "name": "codex-memory-sidecar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local MCP memory sidecar for Codex app.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint .",
    "format:check": "prettier . --check",
    "format": "prettier . --write",
    "dashboard": "tsc -p tsconfig.json && node dist/src/dashboard.js",
    "check:skill-install": "tsc -p tsconfig.json && node dist/src/skill-install-check.js",
    "smoke:mcp": "tsc -p tsconfig.json && node dist/src/mcp-smoke.js",
    "smoke:ollama": "tsc -p tsconfig.json && node dist/src/ollama-smoke.js",
    "smoke:practical": "tsc -p tsconfig.json && node dist/src/practical-smoke.js",
    "smoke:hook": "tsc -p tsconfig.json && node dist/src/hook-session-start-smoke.js",
    "smoke:comparison": "tsc -p tsconfig.json && node dist/src/comparison-smoke.js",
    "bench:recall": "tsc -p tsconfig.json && node dist/src/recall-benchmark.js",
    "start": "node dist/src/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.13.0",
    "better-sqlite3": "^11.10.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "eslint": "^10.4.1",
    "prettier": "^3.8.4",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.61.0",
    "vitest": "^3.1.0"
  }
}
